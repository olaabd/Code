def decrypt_caesar(cipher_text):
    alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    cipher_text = cipher_text.upper()
    possible_texts = []

    for shift in range(1, 26):  # Try all 25 possible shifts
        decrypted = ''
        for char in cipher_text:
            if char in alphabet:
                index = (alphabet.index(char) - shift) % 26
                decrypted += alphabet[index]
            else:
                decrypted += char
        possible_texts.append((shift, decrypted))

    return possible_texts


# Example usage:
cipher = "Wklv lv d whvw phvvdjh"  # Caesar cipher with shift 3
results = decrypt_caesar(cipher)
for shift, text in results:
    print(f"Shift {shift}: {text}")
